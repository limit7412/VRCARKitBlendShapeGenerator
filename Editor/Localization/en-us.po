# Auto mapping list
msgid "inspector.section.auto_mappings"
msgstr "Auto Mapping List (Reference)"

msgid "auto_mappings.description"
msgstr "The following blend shapes are mapped automatically. This list is generated from the mapping definitions.\nBlend shape names are matched exactly (case and whitespace sensitive).\nComma separated names are alternatives and the first one found is used. \" / \" separates priority levels: when the level on the left finds nothing, the next one is tried. Sources joined by \" + \" are combined together.\n\"(70%)\" is the weight applied, and \"[Left Only]\" is a side filter that only takes effect while Left/Right Split is on.\nThe left and right ARKit names are searched independently, so when their candidates differ (ウィンク and ウィンク右, for example) only one side may be generated.\nIf the same ARKit name is specified in an enabled custom mapping, the custom mapping takes precedence."

msgid "auto_mappings.fold.eye"
msgstr "Eye"

msgid "auto_mappings.fold.eye_look"
msgstr "Eye Look (most avatars lack these shape keys and need manual setup)"

msgid "auto_mappings.fold.brow"
msgstr "Brow"

msgid "auto_mappings.fold.mouth"
msgstr "Mouth"

msgid "auto_mappings.fold.cheek"
msgstr "Cheek"

msgid "auto_mappings.fold.nose"
msgstr "Nose"

msgid "auto_mappings.fold.tongue"
msgstr "Tongue"

msgid "auto_mappings.row.procedural_fallback"
msgstr " (procedural generation when missing; requires the option to be enabled and a recognized mouth shape key to detect the mouth region)"

