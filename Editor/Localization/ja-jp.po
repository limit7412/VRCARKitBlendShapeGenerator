msgstr "元からあるBlendShape"

msgid "preview.category.empty"
msgstr "なし"

# 自動マッピング一覧
msgid "inspector.section.auto_mappings"
msgstr "自動マッピング一覧（参照用）"

msgid "auto_mappings.description"
msgstr "以下のBlendShapeは自動的にマッピングされます。\nシェイプキー名は完全一致で照合します（大文字小文字と空白も区別）。\n各ARKit名について候補を左から順に検索し、最初に見つかったものを使います。左右のARKit名は独立に検索するため、候補が違う場合（ウィンク と ウィンク右 など）は片方だけが生成されることがあります。\nスラッシュより後ろの候補は、左右分割がONのときだけSideで左右に分割されます。OFFのときは分割せずそのまま適用されます。\nカスタムマッピングで同じARKit名を指定した場合、有効なカスタム設定が優先されます。"

msgid "auto_mappings.fold.eye"
msgstr "目 (Eye)"

msgid "auto_mappings.fold.eye_look"
msgstr "視線 (Eye Look) ※該当シェイプキーが無いアバターが多く手動設定が必要"

msgid "auto_mappings.fold.brow"
msgstr "眉毛 (Brow)"

msgid "auto_mappings.fold.mouth"
msgstr "口 (Mouth)"

msgid "auto_mappings.fold.cheek"
msgstr "頬 (Cheek)"

msgid "auto_mappings.fold.nose"
msgstr "鼻 (Nose)"

msgid "auto_mappings.fold.tongue"
msgstr "舌 (Tongue)"

msgid "auto_mappings.row.eye_blink"
msgstr "← vrc.blink_left/right, blink_left/right, Blink_L/R / vrc.blink, まばたき, ウィンク, ウィンク右, blink"

msgid "auto_mappings.row.eye_squint"
msgstr "← Squint_L/R, squint_left/right / 笑い, にこり, ><, 笑い目 (70%)"

msgid "auto_mappings.row.eye_wide"
msgstr "← Wide_L/R, wide_left/right / びっくり, 見開き, 驚き"

msgid "auto_mappings.row.eye_look_up"
msgstr "← EyeUp_L/R, eye_up_L/R / 目上"

msgid "auto_mappings.row.eye_look_down"
msgstr "← EyeDown_L/R, eye_down_L/R / 目下"

msgid "auto_mappings.row.eye_look_in"
msgstr "← EyeIn_L/R, eye_in_L/R / より目"

msgid "auto_mappings.row.eye_look_out"
msgstr "← EyeOut_L/R, eye_out_L/R（両目用からの分割には未対応）"

msgid "auto_mappings.row.brow_down"
msgstr "← BrowDown_L/R / 怒り, 真面目, 困る"

msgid "auto_mappings.row.brow_inner_up"
msgstr "← 困る, 上, 悲しい, BrowInnerUp"

msgid "auto_mappings.row.brow_outer_up"
msgstr "← BrowOuterUp_L/R / 上, 驚き"

msgid "auto_mappings.row.jaw_open"
msgstr "← vrc.v_aa, あ, a/A (70%)"

msgid "auto_mappings.row.mouth_funnel"
msgstr "← vrc.v_ou, う, u/U"

msgid "auto_mappings.row.mouth_pucker"
msgstr "← vrc.v_ou, う, ω, u/U (120%)"

msgid "auto_mappings.row.mouth_smile"
msgstr "← Smile_L/R / にやり, ∧, にっこり"

msgid "auto_mappings.row.mouth_frown"
msgstr "← Frown_L/R / への字, 悲しみ"

msgid "auto_mappings.row.mouth_left_right"
msgstr "← 口左, 口右, MouthLeft/MouthRight"

msgid "auto_mappings.row.mouth_upper_up"
msgstr "← vrc.v_ih, い, i/I"

msgid "auto_mappings.row.mouth_lower_down"
msgstr "← vrc.v_aa, あ, a/A (60%)"

msgid "auto_mappings.row.mouth_close"
msgstr "← vrc.v_nn, ん, n/N"

msgid "auto_mappings.row.mouth_shrug_upper"
msgstr "← vrc.v_ch, え, e/E"

msgid "auto_mappings.row.mouth_shrug_lower"
msgstr "← vrc.v_oh, お, o/O (50%)"

msgid "auto_mappings.row.mouth_press"
msgstr "← むっ, MouthPress"

msgid "auto_mappings.row.mouth_stretch"
msgstr "← vrc.v_ih, い, i"

msgid "auto_mappings.row.jaw_direction"
msgstr "← JawLeft/JawRight/JawForward"

msgid "auto_mappings.row.procedural_fallback"
msgstr "（無い場合は手続き的生成: 要有効化、口領域の検出に口のシェイプキーが必要）"

msgid "auto_mappings.row.cheek_puff"
msgstr "← ぷく, 膨らみ, CheekPuff"

msgid "auto_mappings.row.cheek_squint"
msgstr "← CheekSquint_L/R / 笑い, にこり (80%)"

msgid "auto_mappings.row.nose_sneer"
msgstr "← NoseSneer_L/R / 怒り"

msgid "auto_mappings.row.tongue_out"
msgstr "← べー, 舌, TongueOut"

# デバッグ
msgid "debug.show_all_meshes"
msgstr "全メッシュのBlendShape数を表示"

msgid "debug.show_target_shapes"
msgstr "対象メッシュのBlendShape名を表示"

# ログ
msgid "log.target_renderer_not_set"
msgstr "Target Rendererが設定されていません。"

msgid "log.preset_applied"
msgstr "VRChat標準表情プリセットを適用しました"

# ビルド・プレビュー時ログ
msgid "log.multiple_components"
msgstr "同一アバター内で複数のARKitBlendShapeGeneratorComponentが検出されました。\"{0}\" のみ処理します。"

msgid "log.duplicate_abort"
msgstr "カスタムマッピングで同一ARKit名が重複しているため、生成を中止しました。\n重複: {0}"

msgid "log.duplicate_preview_stop"
msgstr "カスタムマッピングで同一ARKit名が重複しています。重複を解消するまでプレビューを停止します。\n重複: {0}"

msgid "log.overwrite_merge_abort"
msgstr "メッシュに同名のシェイプキーが複数あり、「既存を上書き」を行うとそれらが1つに統合されてデータが失われるため、生成を中止しました。\n該当: \"{0}\"\nシェイプキー名を一意にするか、「既存を上書き」をオフにしてください。"

msgid "log.renderer_not_found"
msgstr "SkinnedMeshRendererが見つかりません。"

# 重複コンポーネントガード
msgid "guard.log.duplicate"
msgstr "同一アバター内にはARKitBlendShapeGeneratorComponentを1つだけ設定できます。重複コンポーネントを削除します。"

msgid "guard.dialog.duplicate_removed"
msgstr "同一アバター内には ARKitBlendShapeGeneratorComponent を1つだけ設定できます。\n\n重複して追加されたコンポーネントを削除しました。"

# バリデーション
msgid "validation.duplicate.generic"
msgstr "カスタムマッピングに同一ARKit名の重複があります。"

msgid "validation.duplicate.message"
msgstr "カスタムマッピングで同一ARKit名は複数設定できません。\n重複: {0}"
